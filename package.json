{
  "name": "calendario-vault",
  "version": "1.5.1",
  "description": "Vista calendario per Bases (mese, settimana, giorno), calendari Google e form «Nuovo evento». Fork di Calendar Bases di Edrick Leong (MIT).",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "calendar",
    "bases"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "^0.25.10",
    "obsidian": "latest",
    "prettier": "^3.6.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.21",
    "ical.js": "^2.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
